# Cada stage instala sus propias dependencias dentro de la imagen. Copiar las
# del host al contexto de build es innecesario, lento y además ROMPE el build:
# los symlinks de node_modules/.bin/* hacen fallar la transferencia del contexto
# con "invalid file request node_modules/.bin/...".
node_modules
vendor

# Assets y código generado: se recrean dentro de la imagen.
#  - public/build       -> stage `frontend` (npm run build)
#  - resources/js/{actions,routes,wayfinder} -> stage `codegen` (php artisan wayfinder:generate)
public/build
public/hot
resources/js/actions
resources/js/routes
resources/js/wayfinder

# Entorno y secretos: los aporta docker-compose (env_file) en runtime, no la
# imagen. Los stages que necesitan artisan copian .env.example -> .env.
.env
.env.backup
.env.production

# Dumps de base de datos (se montan aparte en el servicio db, no van en la app).
*.sql
base de datos/

# VCS, editores y herramientas de desarrollo
.git
.gitignore
.gitattributes
.github
.idea
.vscode
.fleet
.editorconfig

# Pruebas y análisis estático (no se ejecutan en la imagen de runtime)
tests
phpunit.xml
phpstan.neon
pint.json

# Caché y datos locales
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*.php
storage/framework/testing/*
bootstrap/cache/*.php

# Documentación y misc del repo
README.md
MEMORIA_PROYECTO.md
CLAUDE.md
